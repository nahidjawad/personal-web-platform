#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly SECRETS_FILE={{ (backup_secrets_root ~ '/restic.env') | quote }}
readonly RESTIC_CACHE_DIR={{ backup_cache_root | quote }}
readonly LOCK_FILE=/run/lock/personal-web-backup.lock

export RESTIC_CACHE_DIR

exec 9>"${LOCK_FILE}"
if ! flock --nonblock 9; then
    echo "A backup or maintenance run is already active; exiting."
    exit 0
fi

set -a
# shellcheck disable=SC1090
source "${SECRETS_FILE}"
set +a

restic forget \
    --host "$(hostname --short)" \
    --tag chintavabna \
    --keep-daily {{ backup_keep_daily }} \
    --keep-weekly {{ backup_keep_weekly }} \
    --keep-monthly {{ backup_keep_monthly }} \
    --prune

restic check --read-data-subset=5%

echo "Backup maintenance completed successfully."
