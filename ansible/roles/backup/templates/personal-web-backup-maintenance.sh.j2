#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly SECRETS_FILE={{ (backup_secrets_root ~ '/restic.env') | quote }}
readonly RESTIC_CACHE_DIR={{ backup_cache_root | quote }}
readonly HEALTHCHECKS_URL_FILE={{ backup_healthchecks_maintenance_url_file | quote }}
readonly LOCK_FILE=/run/lock/personal-web-backup.lock

export RESTIC_CACHE_DIR

exec 9>"${LOCK_FILE}"
if ! flock --nonblock 9; then
    echo "A backup or maintenance run is already active; exiting."
    exit 0
fi

set -a
# shellcheck disable=SC1090
source "${SECRETS_FILE}"
set +a

healthchecks_url="$(<"${HEALTHCHECKS_URL_FILE}")"
healthchecks_url="${healthchecks_url%/}"
readonly healthchecks_url

notify_healthchecks() {
    local suffix="${1:-}"

    if ! curl \
        --fail \
        --silent \
        --show-error \
        --max-time 10 \
        --retry 3 \
        --output /dev/null \
        "${healthchecks_url}${suffix}"; then
        echo "Warning: Healthchecks.io notification failed (${suffix:-success})." >&2
    fi
}

finish() {
    local exit_code=$?

    trap - EXIT

    if [[ "${exit_code}" -eq 0 ]]; then
        notify_healthchecks
    else
        notify_healthchecks /fail
    fi

    exit "${exit_code}"
}
trap finish EXIT

notify_healthchecks /start

restic forget \
    --tag chintavabna \
    --keep-daily {{ backup_keep_daily }} \
    --keep-weekly {{ backup_keep_weekly }} \
    --keep-monthly {{ backup_keep_monthly }} \
    --prune

restic check --read-data-subset=5%
restic cache --cleanup

echo "Backup maintenance completed successfully."
